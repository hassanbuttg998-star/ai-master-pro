{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/collections/:slug",
      "destination": "/collections"
    },
    {
      "source": "/post/:id",
      "destination": "/api/post?id=:id"
    },
    {
      "source": "/sitemap-posts.xml",
      "destination": "/api/sitemap-posts"
    }
  ]
}
